(function(){
  const w = window;

  function getCookie(name) {
    const cookies = document.cookie.split('; ').reduce((acc, cookie) => {
      const [key, ...valueParts] = cookie.split('=');
      if (key) {
        acc[key] = decodeURIComponent(valueParts.join('='));
      }
      return acc;
    }, {});

    return cookies[name] || '';
  }

  const lm_params = new URLSearchParams(window.location.search);
  const params = [
          "gclid",
          "gbraid",
          "wbraid",
          "fbclid",
          "lclid",
          "yclid",
          "utm_source",
          "utm_medium",
          "utm_campaign",
          "utm_content",
      ];

  const addParams = new URLSearchParams();

  params.forEach((param) => {
    const val = lm_params.get(param);
    if (val) addParams.set(param, val);
  });

  if (addParams.toString()) {
    localStorage.setItem("lm_param", addParams.toString());
  }

  const lm_param = addParams.toString()
    ? addParams
    : new URLSearchParams(localStorage.getItem("lm_param") || "");

  const lm_links = document.querySelectorAll(
    'a[href^="https://liff.line.me/"][href*="/landing?follow=%40"]'
  );
  w.lmProcessed = w.lmProcessed || new Set();
  lm_links.forEach((link) => {
    const urlObj = new URL(link.href);
    lm_param.forEach((value, key) => {
      urlObj.searchParams.set(key, value);
    });
    link.href = urlObj.href;

    if (!w.lmProcessed.has(link)) {
      w.lmProcessed.add(link);
      link.addEventListener('click', (e) => {
        const fbp = getCookie('_fbp');
        const fbc = getCookie('_fbc');

        const urlObj = new URL(link.href);
        if (fbp) {
          urlObj.searchParams.set('fbp', fbp);
        }
        if (fbc) {
          urlObj.searchParams.set('fbc', fbc);
        }

        link.href = urlObj.href;
      });
    }
  });
})();