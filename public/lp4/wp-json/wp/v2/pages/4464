=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<div class=\"elementor-menu-anchor\" id=\"form\"><\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-de70f9f e-con-full e-flex e-con e-child\" data-id=\"de70f9f\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t<div class=\"elementor-element elementor-element-97f5bb0 elementor-widget elementor-widget-html\" data-id=\"97f5bb0\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n  <meta charset=\"UTF-8\" \/>\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" \/>\n  <title>AI\u30bb\u30df\u30ca\u30fc\u4e88\u7d04\u30d5\u30a9\u30fc\u30e0<\/title>\n  <style>\n    :root { --primary-green: #00d358; --text-main: #333; }\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n    body { font-family: sans-serif; background: #f4f7fa; color: var(--text-main); }\n    .form-container { max-width: 450px; margin: 0 auto; background: white; }\n    .header { background: linear-gradient(90deg, #1e58ff, #7f39fb); color: white; padding: 20px; font-size: 20px; font-weight: bold; }\n    .section { padding: 20px; }\n    .label-group { display: flex; align-items: center; margin-bottom: 15px; font-weight: bold; }\n    .badge-ok { background: var(--primary-green); color: white; border-radius: 4px; padding: 2px 6px; font-size: 11px; margin-right: 8px; }\n    .badge-required { background: #ff4d4f; color: white; border-radius: 4px; padding: 2px 6px; font-size: 11px; margin-right: 8px; }\n    .time-slots { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }\n    .skeleton { background: linear-gradient(90deg, #eee 25%, #f5f5f5 50%, #eee 75%); background-size: 200% 100%; animation: shimmer 1.5s infinite; border-radius: 8px; height: 60px; }\n    @keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }\n    .time-slot-btn { border: 2px solid #ddd; border-radius: 8px; padding: 12px; text-align: center; cursor: pointer; background: white; transition: 0.3s; }\n    .time-slot-btn:hover { border-color: #aaa; }\n    .time-slot-btn.selected { border-color: var(--primary-green); background: #f0fff4; }\n    .slot-date { font-weight: bold; font-size: 15px; }\n    .slot-time { font-size: 13px; color: #666; }\n    #step2 { max-height: 0; overflow: hidden; transition: max-height 0.5s ease; }\n    #step2.open { max-height: 800px; }\n    .step2-inner { padding: 20px; border-top: 1px solid #eee; }\n    .selected-date-label { color: #2160fd; font-size: 14px; font-weight: bold; margin-bottom: 15px; }\n    .input-field { width: 100%; padding: 15px; border: 1px solid #ccc; border-radius: 8px; font-size: 16px; margin-bottom: 20px; }\n    .age-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-bottom: 20px; }\n    .age-btn { border: 1px solid #ccc; border-radius: 6px; padding: 10px 0; text-align: center; font-size: 14px; cursor: pointer; user-select: none; }\n    .age-btn.selected { background: #f0fff4; border-color: var(--primary-green); font-weight: bold; }\n    .submit-btn { background: linear-gradient(to bottom, #00e676, #00c853); color: white; border: none; width: 100%; padding: 18px; border-radius: 50px; font-size: 18px; font-weight: bold; cursor: pointer; }\n    .submit-btn:disabled { opacity: 0.6; cursor: not-allowed; }\n  <\/style>\n<\/head>\n<body>\n<div class=\"form-container\">\n  <div class=\"header\">\u30bb\u30df\u30ca\u30fc\u958b\u50ac\u65e5\u7a0b<\/div>\n  <div class=\"section\">\n    <div class=\"label-group\"><span class=\"badge-required\" id=\"dateBadge\">\u5fc5\u9808<\/span> \u5e0c\u671b\u65e5\u7a0b\u3092\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044<\/div>\n    <div class=\"time-slots\" id=\"timeSlots\">\n      <div class=\"skeleton\"><\/div><div class=\"skeleton\"><\/div><div class=\"skeleton\"><\/div><div class=\"skeleton\"><\/div>\n    <\/div>\n  <\/div>\n  <div id=\"step2\">\n    <div class=\"step2-inner\">\n      <div class=\"selected-date-label\" id=\"selectedDateLabel\"><\/div>\n      <div class=\"label-group\"><span class=\"badge-required\">\u5fc5\u9808<\/span> \u304a\u540d\u524d<\/div>\n      <input type=\"text\" id=\"userName\" class=\"input-field\" placeholder=\"AI\u30b9\u30ad\u30eb \u592a\u90ce\" \/>\n      <div class=\"label-group\"><span class=\"badge-required\">\u5fc5\u9808<\/span> \u30e1\u30fc\u30eb\u30a2\u30c9\u30ec\u30b9<\/div>\n      <input type=\"email\" id=\"userEmail\" class=\"input-field\" placeholder=\"example@mail.com\" \/>\n      <div class=\"label-group\"><span class=\"badge-ok\">OK<\/span> \u5e74\u4ee3<\/div>\n      <div class=\"age-grid\" id=\"ageGrid\">\n        <div class=\"age-btn\">10\u4ee3<\/div><div class=\"age-btn\">20\u4ee3<\/div><div class=\"age-btn selected\">30\u4ee3<\/div>\n        <div class=\"age-btn\">40\u4ee3<\/div><div class=\"age-btn\">50\u4ee3<\/div><div class=\"age-btn\">60\u4ee3<\/div>\n        <div class=\"age-btn\" style=\"grid-column: span 2;\">70\u4ee3\u4ee5\u964d<\/div>\n      <\/div>\n      <button class=\"submit-btn\" id=\"submitBtn\" type=\"button\" onclick=\"submitBooking()\">\u7121\u6599\u3067\u53c2\u52a0URL\u3092\u53d7\u3051\u53d6\u308b<\/button>\n    <\/div>\n  <\/div>\n<\/div>\n<script>\n  \/\/ \u2605\u2605\u2605 LP\u3054\u3068\u306b\u3053\u3053\u3060\u3051\u5909\u3048\u308b \u2605\u2605\u2605\n  const GAS_URL    = 'https:\/\/script.google.com\/macros\/s\/AKfycbxZfxhiILoHXK83yGkSkeRhT4XN1-cHOiPpDc_AoD7znm-__JrbwLk1GauKf0EAeILrmg\/exec';  \/\/ \u5168LP\u5171\u901a\uff081\u56de\u8a2d\u5b9a\u3057\u305f\u3089\u5909\u66f4\u4e0d\u8981\uff09\n  const EVENT_TYPE_ID = '5098589';                              \/\/ \u5168LP\u5171\u901a\uff08\u5909\u66f4\u4e0d\u8981\uff09\n  const THANKS_URL = 'https:\/\/lp4.bytech.jp\/thanks\/';          \/\/ \u2190 LP\u5225\n  const LP_TYPE    = 'normal';                                  \/\/ \u2190 LP\u5225: 'normal' or 'senior'\n  const SOURCE     = '\u30d0\u30a4\u30c6\u30c3\u30afGEN\u30a6\u30a7\u30d3\u30ca\u30fc\u3010ASP\u7d4c\u7531\/lp4\u3011';     \/\/ \u2190 LP\u5225: \u6d41\u5165\u5143\u540d\n\n  let selectedStart = '';\n  window.dataLayer = window.dataLayer || [];\n\n  async function fetchSlots() {\n    try {\n      const res = await fetch(`${GAS_URL}?event_type_id=${EVENT_TYPE_ID}`, { cache: 'no-store' });\n      const text = await res.text();\n      let result;\n      try { result = JSON.parse(text); } catch {\n        document.getElementById('timeSlots').innerText = '\u67a0\u306e\u53d6\u5f97\u306b\u5931\u6557\u3057\u307e\u3057\u305f'; return;\n      }\n      const slots = result?.data ?? [];\n      if (!Array.isArray(slots) || slots.length === 0) {\n        document.getElementById('timeSlots').innerText = '\u73fe\u5728\u3001\u4e88\u7d04\u53ef\u80fd\u306a\u67a0\u304c\u3042\u308a\u307e\u305b\u3093'; return;\n      }\n      renderSlots(slots);\n    } catch {\n      document.getElementById('timeSlots').innerText = '\u67a0\u306e\u53d6\u5f97\u306b\u5931\u6557\u3057\u307e\u3057\u305f';\n    }\n  }\n\n  function renderSlots(slots) {\n    const container = document.getElementById('timeSlots');\n    container.innerHTML = '';\n    const now = new Date();\n    const futureSlots = slots.filter(slot => new Date(slot.startedAt) > now);\n    if (futureSlots.length === 0) {\n      container.innerText = '\u73fe\u5728\u3001\u4e88\u7d04\u53ef\u80fd\u306a\u67a0\u304c\u3042\u308a\u307e\u305b\u3093'; return;\n    }\n    futureSlots.forEach(slot => {\n      const d = new Date(slot.startedAt);\n      const dateStr = d.toLocaleDateString('ja-JP', { timeZone: 'Asia\/Tokyo', month: '2-digit', day: '2-digit', weekday: 'short' });\n      const timeStr = d.toLocaleTimeString('ja-JP', { timeZone: 'Asia\/Tokyo', hour: '2-digit', minute: '2-digit' }) + '\u301c';\n      const div = document.createElement('div');\n      div.className = 'time-slot-btn';\n      div.dataset.start = slot.startedAt;\n      div.innerHTML = `<div class=\"slot-date\">${dateStr}<\/div><div class=\"slot-time\">${timeStr}<\/div>`;\n      div.onclick = function () {\n        document.querySelectorAll('.time-slot-btn').forEach(b => b.classList.remove('selected'));\n        this.classList.add('selected');\n        selectedStart = slot.startedAt;\n        document.getElementById('selectedDateLabel').textContent = `\u9078\u629e\u4e2d: ${dateStr} ${timeStr}`;\n        document.getElementById('step2').classList.add('open');\n        const badge = document.getElementById('dateBadge');\n        badge.textContent = 'OK';\n        badge.className = 'badge-ok';\n        dataLayer.push({ event: 'form_slot_click', slot_date: dateStr });\n        setTimeout(() => { document.getElementById('step2').scrollIntoView({ behavior: 'smooth', block: 'start' }); }, 300);\n      };\n      container.appendChild(div);\n    });\n  }\n\n  async function submitBooking() {\n    const name = document.getElementById('userName').value.trim();\n    const email = document.getElementById('userEmail').value.trim();\n    const ageEl = document.querySelector('.age-btn.selected');\n    const age = ageEl ? ageEl.innerText : '';\n    if (!selectedStart || !name || !email) return alert('\u5fc5\u9808\u9805\u76ee\u3092\u5165\u529b\u3057\u3066\u304f\u3060\u3055\u3044');\n\n    dataLayer.push({ event: 'form_submit_click' });\n\n    const btn = document.getElementById('submitBtn');\n    btn.innerText = '\u9001\u4fe1\u4e2d...';\n    btn.disabled = true;\n\n    try {\n      const params = new URLSearchParams({\n        action: 'book',\n        event_type_id: EVENT_TYPE_ID,\n        started_at: selectedStart,\n        name, email, age,\n        lp_type: LP_TYPE,\n        source: SOURCE\n      });\n      const res = await fetch(`${GAS_URL}?${params}`, { cache: 'no-store' });\n      const text = await res.text();\n      let result;\n      try { result = JSON.parse(text); } catch { throw new Error('Invalid response'); }\n\n      if (result.error) {\n        alert('\u30a8\u30e9\u30fc: ' + result.error);\n      } else {\n        dataLayer.push({ event: 'form_complete' });\n        window.location.href = THANKS_URL;\n      }\n    } catch {\n      alert('\u901a\u4fe1\u30a8\u30e9\u30fc\u304c\u767a\u751f\u3057\u307e\u3057\u305f\u3002\u3082\u3046\u4e00\u5ea6\u304a\u8a66\u3057\u304f\u3060\u3055\u3044\u3002');\n    } finally {\n      btn.innerText = '\u7121\u6599\u3067\u53c2\u52a0URL\u3092\u53d7\u3051\u53d6\u308b';\n      btn.disabled = false;\n    }\n  }\n\n  document.getElementById('userName').addEventListener('focus', function() {\n    dataLayer.push({ event: 'form_name_focus' });\n  }, { once: true });\n  document.getElementById('userEmail').addEventListener('focus', function() {\n    dataLayer.push({ event: 'form_email_focus' });\n  }, { once: true });\n  document.getElementById('ageGrid').addEventListener('click', (e) => {\n    if (e.target.classList.contains('age-btn')) {\n      document.querySelectorAll('.age-btn').forEach(b => b.classList.remove('selected'));\n      e.target.classList.add('selected');\n    }\n  });\n\n  fetchSlots();\n<\/script>\n<\/body>\n<\/html>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-24fd5c8 e-con-full e-flex e-con e-child\" data-id=\"24fd5c8\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t<div class=\"elementor-element elementor-element-7e676a2 elementor-widget elementor-widget-image\" data-id=\"7e676a2\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img decoding=\"async\" width=\"436\" height=\"145\" src=\"https:\/\/lp4.bytech.jp\/wp-content\/uploads\/2026\/01\/\u30b0\u30eb\u30f