        <section>
            <div class="f990 pb20 mt0 sp-mt0 sp-mb0">
                <h2 class="txt-center mb30 lh1 sp-mt80 sp-mb10">
                    <p class="font22">TOTAL</p>
                    <em class="font120 sp-font17vw">1,000</em><span class="font22">時間</span>
